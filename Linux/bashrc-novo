# ==========================================
# CONFIGURAÇÃO CUSTOMIZADA .BASHRC MODERNA
# ==========================================

# --- HISTÓRICO ULTRA REFORÇADO ---
# Aumenta o limite e evita duplicados para que você nunca perca comandos passados
export HISTSIZE=50000
export HISTFILESIZE=100000
export HISTCONTROL=ignoreboth:erasedups
shopt -s histappend # Salva o histórico imediatamente, sem esperar fechar o terminal
shopt -s cmdhist    # Salva comandos de múltiplas linhas como um só

# --- COMPORTAMENTO DO TERMINAL ---
shopt -s autocd 2>/dev/null  # Digitar apenas o caminho da pasta entra nela diretamente
shopt -s globstar 2>/dev/null # Permite usar ** para buscas recursivas
shopt -s cdspell 2>/dev/null  # Corrige pequenos erros de digitação ao usar 'cd'

# --- CORES E APARÊNCIA ---
export CLI_COLOR=1
export FORCE_COLOR_PROMPT=yes

# Cores para o comando 'ls' (padrão elegante e moderno)
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias dir='dir --color=auto'
    alias vdir='vdir --color=auto'
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

# --- ATALHOS DE PRODUTIVIDADE (ALIASES) ---

# Navegação e Listagem melhoradas
alias ll='ls -lahF --group-directories-first'
alias la='ls -A'
alias l='ls -CF'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../../..'

# Atalhos de Segurança (pede confirmação para evitar desastres)
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# Ferramentas úteis do sistema
alias df='df -h'     # Uso de disco legível por humanos
alias free='free -m' # Uso de memória em MB

# Atalhos rápidos de Atualização (Ubuntu/Debian) - Ajuste se usar Fedora/Arch
alias update='sudo apt update && sudo apt upgrade -y'
alias clean='sudo apt autoremove -y && sudo apt autoclean'

if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# --- FUNÇÕES INTELIGENTES ---

# 1. Extrair qualquer arquivo compactado com apenas um comando ('ex arquivo.tar.gz')
ex () {
    if [ -f $1 ] ; then
        case $1 in
            *.tar.bz2)   tar xjf $1     ;;
            *.tar.gz)    tar xzf $1     ;;
            *.bz2)       bunzip2 $1     ;;
            *.rar)       unrar x $1     ;;
            *.gz)        gunzip $1      ;;
            *.tar)       tar xf $1      ;;
            *.tbz2)      tar xjf $1     ;;
            *.tgz)       tar xzf $1     ;;
            *.zip)       unzip $1       ;;
            *.Z)         uncompress $1  ;;
            *.7z)        7z x $1        ;;
            *)           echo "'$1' não pode ser extraído via ex()" ;;
        esac
    else
        echo "'$1' não é um arquivo válido"
    fi
}

# 2. Criar um diretório e entrar nele imediatamente ('mkd nome_da_pasta')
mkd() {
    mkdir -p "$1" && cd "$1"
}

# --- PROMPT VISUAL MODERNO (PS1) ---
# Mostra o status do Git de forma limpa, diretório atual destacado em azul e ícones funcionais.
parse_git_branch() {
    git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/ ( )/'
}

# Cores ANSI para o Prompt
BLUE="\[\033[01;34m\]"
GREEN="\[\033[01;32m\]"
CYAN="\[\033[01;36m\]"
RED="\[\033[01;31m\]"
PURPLE="\[\033[01;35m\]"
RESET="\[\033[00m\]"

# Se estiver via SSH, o prompt ganha uma tag visual de alerta amarela/roxa
if [ -n "$SSH_CLIENT" ] || [ -n "$SSH_CONNECTION" ]; then
    SSH_INFO="${PURPLE} SSH "
else
    SSH_INFO=""
fi

# enable programmable completion features (you don't need to enable
# this, if it's already enabled in /etc/bash.bashrc and /etc/profile
# sources /etc/bash.bashrc).
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

# Configuração final do Prompt: [Símbolo] Usuário@Máquina | Pasta Atual (Ramo Git) ->
export PS1="${SSH_INFO}${GREEN}󰣚 \u${RESET}@${CYAN}\h${RESET} ${BLUE} \w${RED}\$(parse_git_branch)${RESET}\n❯ "

eval "$(fzf --bash)"

