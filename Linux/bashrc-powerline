# ==========================================
# CONFIGURAÇÃO CUSTOMIZADA .BASHRC POWERLINE
# ==========================================
# Configure uma Nerd Font no terminal, como MesloLGS NF.

export HISTSIZE=50000
export HISTFILESIZE=100000
export HISTCONTROL=ignoreboth:erasedups
shopt -s histappend # Acrescenta o histórico ao encerrar a sessão.
shopt -s cmdhist

shopt -s autocd 2>/dev/null
shopt -s globstar 2>/dev/null
shopt -s cdspell 2>/dev/null

export CLI_COLOR=1
export FORCE_COLOR_PROMPT=yes

if [ -x /usr/bin/dircolors ]; then
    if [ -r ~/.dircolors ]; then
        eval "$(dircolors -b ~/.dircolors)"
    else
        eval "$(dircolors -b)"
    fi
    alias ls='ls --color=auto'
    alias dir='dir --color=auto'
    alias vdir='vdir --color=auto'
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

alias ll='ls -lahF --group-directories-first'
alias la='ls -A'
alias l='ls -CF'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../../..'
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'
alias df='df -h'
alias free='free -m'
alias update='sudo apt update && sudo apt upgrade -y'
alias clean='sudo apt autoremove -y && sudo apt autoclean'

if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

ex() {
    if [[ $# -ne 1 || ! -f $1 ]]; then
        printf 'Uso: ex arquivo_compactado\n' >&2
        return 1
    fi
    case "$1" in
        *.tar.bz2) tar xjf "$1" ;;
        *.tar.gz)  tar xzf "$1" ;;
        *.bz2)     bunzip2 "$1" ;;
        *.rar)     unrar x "$1" ;;
        *.gz)      gunzip "$1" ;;
        *.tar)     tar xf "$1" ;;
        *.tbz2)    tar xjf "$1" ;;
        *.tgz)     tar xzf "$1" ;;
        *.zip)     unzip "$1" ;;
        *.Z)       uncompress "$1" ;;
        *.7z)      7z x "$1" ;;
        *) printf "'%s' não pode ser extraído via ex()\n" "$1" >&2; return 1 ;;
    esac
}

mkd() {
    mkdir -p -- "$1" && cd -- "$1"
}

if ! shopt -oq posix; then
    if [ -f /usr/share/bash-completion/bash_completion ]; then
        . /usr/share/bash-completion/bash_completion
    elif [ -f /etc/bash_completion ]; then
        . /etc/bash_completion
    fi
fi

# --- PROMPT POWERLINE (Bash 4.4+) ---
# Referência: paleta azul #7AA2F7, cinza-azulado #3B4261 e fundo #24283B.
__powerline_prompt() {
    local last_status=$?
    local branch
    local reset='\[\e[0m\]'

    # Cores RGB próximas à referência, com separadores Powerline.
    PS1='\[\e[1;38;2;36;40;59;48;2;122;162;247m\] \u '
    PS1+='\[\e[0;38;2;122;162;247;48;2;59;66;97m\]'
    PS1+='\[\e[1;38;2;122;162;247;48;2;59;66;97m\] \h '
    PS1+='\[\e[0;38;2;59;66;97;48;2;36;40;59m\]'
    PS1+='\[\e[1;38;2;122;162;247;48;2;36;40;59m\]  \w '

    __powerline_git=''
    if command -v git >/dev/null 2>&1; then
        if branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null); then
            __powerline_git=$branch
        elif branch=$(git rev-parse --short HEAD 2>/dev/null); then
            __powerline_git="detached:${branch}"
        fi
    fi
    if [[ -n $__powerline_git ]]; then
        PS1+=' ${__powerline_git} '
    fi
    if [[ -n ${SSH_CONNECTION:-} || -n ${SSH_CLIENT:-} ]]; then
        PS1+='SSH '
    fi
    PS1+="${reset}"'\[\e[38;2;36;40;59m\]'
    PS1+="${reset} "
    if (( last_status != 0 )); then
        PS1+='\[\e[31m\]'
        PS1+="${last_status}${reset} "
    fi
    return "$last_status"
}
# --- FZF: TEMA POWERLINE AZUL ---
# Requer uma Nerd Font para o separador Powerline.
# Guarda as opções anteriores e evita duplicação ao executar source novamente.
if [[ ! ${__fzf_powerline_base_opts+x} ]]; then
    __fzf_powerline_base_opts=${FZF_DEFAULT_OPTS-}
fi
export FZF_DEFAULT_OPTS="${__fzf_powerline_base_opts}
  --height=45%
  --layout=reverse
  --border=rounded
  --info=inline
  --prompt=' '
  --pointer=''
  --marker='✓'
  --color=bg:#24283B,fg:#C0CAF5,bg+:#3B4261,fg+:#C0CAF5
  --color=hl:#7AA2F7,hl+:#7AA2F7,prompt:#7AA2F7,pointer:#7AA2F7
  --color=marker:#7AA2F7,spinner:#7AA2F7,info:#7AA2F7,header:#7AA2F7
  --color=border:#3B4261,gutter:#24283B
  --color=preview-bg:#24283B,preview-fg:#C0CAF5
"

if command -v fzf >/dev/null 2>&1; then
    eval "$(fzf --bash)"
fi

# Preserva outros comandos registrados e evita duplicação ao recarregar.
if [[ ${PROMPT_COMMAND@a} == *a* ]]; then
    if [[ ";${PROMPT_COMMAND[*]};" != *"__powerline_prompt"* ]]; then
        PROMPT_COMMAND=(__powerline_prompt "${PROMPT_COMMAND[@]}")
    fi
elif [[ ${PROMPT_COMMAND:-} != *"__powerline_prompt"* ]]; then
    PROMPT_COMMAND="__powerline_prompt${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
fi
